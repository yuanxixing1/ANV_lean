theorem AnvBandit.BaselineLaw.canonical_original_law : ∀ {n K : ℕ} (M : AnvBandit.DecayModel n K)
  (p : AnvBandit.BaselineExecution.Params n K) (lam : Fin 2),
  (∀ t < p.T,
      ⇑(ProbabilityTheory.condDistrib (fun ω => (ω (t + 1)).1) (Preorder.frestrictLe t)
            (AnvBandit.BaselineLaw.executionMeasure M p
              lam)) =ᵐ[MeasureTheory.Measure.map (Preorder.frestrictLe t)
          (AnvBandit.BaselineLaw.executionMeasure M p lam)]
        ⇑(AnvBandit.BaselineLaw.rewardKernel M p lam t)) ∧
