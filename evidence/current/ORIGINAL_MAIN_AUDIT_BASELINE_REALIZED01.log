      ∀ᵐ (ω : AnvBandit.BaselineLaw.Path n) ∂AnvBandit.BaselineLaw.executionMeasure M p lam, (ω (t + 1)).2 = id :=
fun {n K} M p lam =>
  ⟨fun t x => AnvBandit.BaselineLaw.conditional_reward_law M p lam t, fun t x =>
    AnvBandit.BaselineLaw.canonical_no_contact M p lam t⟩
