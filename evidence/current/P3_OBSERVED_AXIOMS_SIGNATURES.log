@AnvBandit.ExecutionLaw.retainedContact_iff_communicates : ∀ {n K : ℕ} (p : AnvBandit.Execution.Params n K)
  (ω : AnvBandit.ExecutionLaw.Path n),
  ∀ t < p.T,
    AnvBandit.ExecutionLaw.retainedContact p (t + 1) ↔
      AnvBandit.Execution.communicates p t
        (AnvBandit.Execution.run p (AnvBandit.ExecutionLaw.realTape (AnvBandit.ExecutionLaw.pathRewards ω))
          (AnvBandit.ExecutionLaw.pathContacts p ω) t)
