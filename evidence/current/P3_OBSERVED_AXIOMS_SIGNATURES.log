@AnvBandit.ExecutionLaw.finite_observed_statistic_transfer : ∀ {n K : ℕ} {A : Type u_1} [inst : MeasurableSpace A]
  (M : AnvBandit.DecayModel n K) (p : AnvBandit.Execution.Params n K) (C : AnvBandit.ContactMatrix n) (lam : Fin 2)
  (ν : MeasureTheory.Measure (AnvBandit.ExecutionLaw.Path n)) [inst_1 : MeasureTheory.IsProbabilityMeasure ν],
  MeasureTheory.Measure.map (Preorder.frestrictLe 0) ν =
      MeasureTheory.Measure.map (Preorder.frestrictLe 0) (AnvBandit.ExecutionLaw.observedMeasure M p C lam) →
    (∀ t < p.T,
        ⇑(ProbabilityTheory.condDistrib (fun ω => ω (t + 1)) (Preorder.frestrictLe t)
              ν) =ᵐ[MeasureTheory.Measure.map (Preorder.frestrictLe t) ν]
          ⇑(AnvBandit.ExecutionLaw.observedKernel M p C lam t)) →
      ∀ t ≤ p.T,
        ∀ (f : AnvBandit.ExecutionLaw.Prefix n t → A),
          (∀ (h : AnvBandit.ExecutionLaw.Prefix n t), f (AnvBandit.ExecutionLaw.observedPrefix p t h) = f h) →
            MeasureTheory.Measure.map (fun ω => f (Preorder.frestrictLe t ω)) ν =
              MeasureTheory.Measure.map (fun ω => f (Preorder.frestrictLe t ω))
                (AnvBandit.ExecutionLaw.executionMeasure M p C lam)
