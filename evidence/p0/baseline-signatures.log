  1 < β →
    ∀ (c : Fin K → ℝ) (L : ℝ) (lam : Fin 2),
      (∀ (k : Fin K), 0 ≤ c k) →
        ∀ (Lc Elam : ℝ),
          Lc ≤ (↑n * M.supOthers fun k => c k) * ↑T →
            Lc ≤ Elam + (δ * ↑n * M.supOthers fun k => c k) * ↑T →
              Lc ≤ min ((↑n * M.supOthers fun k => c k) * ↑T) (Elam + (δ * ↑n * M.supOthers fun k => c k) * ↑T) :=
fun {n K} M T h δ β hβ c L lam hc Lc Elam hcrude hE => le_min hcrude hE
