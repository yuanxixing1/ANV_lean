    (hp : ∀ (i : Fin n), M.AdaptMeanInGap (p i)) (hc : ∀ (i : Fin n), AnvBandit.DecayModel.ConcEvent L (bhat i) (p i))
    (I : ℕ → Fin n → Fin K) (N : ℕ → Fin n → Fin K → ℕ) (Nzero : ∀ (i : Fin n) (k : Fin K), N 0 i k = 0)
    (Nstep : ∀ (t : ℕ) (i : Fin n) (k : Fin K), N (t + 1) i k = N t i k + if I t i = k then 1 else 0)
    (active : ℕ → Fin n → Finset (Fin K)) (sel_mem : ∀ (t : ℕ) (i : Fin n), I t i ∈ active t i)
    (ucb :
      ∀ (t : ℕ) (i : Fin n),
