                  bhat i (I t i) (N t i (I t i)) + AnvBandit.rdelta L (N t i (I t i))) :
    AnvBandit.GoodRun M
structure AnvBandit.RunModel {n K : ℕ} (M : AnvBandit.DecayModel n K) : Type
number of parameters: 3
fields:
  AnvBandit.RunModel.l0 : ℕ
  AnvBandit.RunModel.i0 : Fin n
  AnvBandit.RunModel.Aph : ℕ → Fin n → Finset (Fin K)
  AnvBandit.RunModel.cache : ℕ → Fin n → Fin K
  AnvBandit.RunModel.J : ℕ → Fin n → Fin n
  AnvBandit.RunModel.source_holds : ∀ (ℓ : ℕ), M.star ∈ self.Aph ℓ self.i0
  AnvBandit.RunModel.rec_star : ∀ (ℓ : ℕ) (i : Fin n), self.l0 ≤ ℓ → M.star ∈ self.Aph ℓ i → self.cache ℓ i = M.star
  AnvBandit.RunModel.upd_get : ∀ (ℓ : ℕ) (i : Fin n),
      self.l0 ≤ ℓ → self.cache ℓ (self.J ℓ i) = M.star → M.star ∈ self.Aph (ℓ + 1) i
  AnvBandit.RunModel.upd_keep : ∀ (ℓ : ℕ) (i : Fin n), self.l0 ≤ ℓ → M.star ∈ self.Aph ℓ i → M.star ∈ self.Aph (ℓ + 1) i
constructor:
  AnvBandit.RunModel.mk {n K : ℕ} {M : AnvBandit.DecayModel n K} (l0 : ℕ) (i0 : Fin n)
    (Aph : ℕ → Fin n → Finset (Fin K)) (cache : ℕ → Fin n → Fin K) (J : ℕ → Fin n → Fin n)
    (source_holds : ∀ (ℓ : ℕ), M.star ∈ Aph ℓ i0)
    (rec_star : ∀ (ℓ : ℕ) (i : Fin n), l0 ≤ ℓ → M.star ∈ Aph ℓ i → cache ℓ i = M.star)
    (upd_get : ∀ (ℓ : ℕ) (i : Fin n), l0 ≤ ℓ → cache ℓ (J ℓ i) = M.star → M.star ∈ Aph (ℓ + 1) i)
    (upd_keep : ∀ (ℓ : ℕ) (i : Fin n), l0 ≤ ℓ → M.star ∈ Aph ℓ i → M.star ∈ Aph (ℓ + 1) i) : AnvBandit.RunModel M
def AnvBandit.DecayModel.ConcEvent : {K : ℕ} → ℝ → (Fin K → ℕ → ℝ) → (Fin K → ℕ → ℝ) → Prop :=
fun {K} L bhat p =>
  ∀ (k : Fin K) (m : ℕ), 1 ≤ m → |bhat k m - (∑ s ∈ Finset.range m, p k (s + 1)) / ↑m| ≤ AnvBandit.rdelta L m
def AnvBandit.IsExponential : {n K : ℕ} → AnvBandit.DecayModel n K → (Fin K → ℝ) → (Fin K → ℝ) → Prop :=
fun {n K} M a eta =>
  (∀ (k : Fin K), 0 ≤ a k) ∧
    (∀ (k : Fin K), 0 < eta k) ∧ ∀ (k : Fin K) (s : ℕ), M.f k s = a k * Real.exp (-eta k * (↑s - 1))
structure AnvBandit.ContactMatrix (n : ℕ) : Type
number of parameters: 1
fields:
  AnvBandit.ContactMatrix.P : Fin n → Fin n → ℝ
  AnvBandit.ContactMatrix.nonneg : ∀ (i j : Fin n), 0 ≤ self.P i j
  AnvBandit.ContactMatrix.row_sum : ∀ (i : Fin n), ∑ j, self.P i j = 1
  AnvBandit.ContactMatrix.pmin : ℝ
  AnvBandit.ContactMatrix.pmin_pos : 0 < self.pmin
  AnvBandit.ContactMatrix.le_pmin : ∀ (i j : Fin n), 0 < self.P i j → self.pmin ≤ self.P i j
  AnvBandit.ContactMatrix.irreducible : ∀ (a b : Fin n), Relation.ReflTransGen (fun x y => 0 < self.P y x) a b
constructor:
  AnvBandit.ContactMatrix.mk {n : ℕ} (P : Fin n → Fin n → ℝ) (nonneg : ∀ (i j : Fin n), 0 ≤ P i j)
    (row_sum : ∀ (i : Fin n), ∑ j, P i j = 1) (pmin : ℝ) (pmin_pos : 0 < pmin)
    (le_pmin : ∀ (i j : Fin n), 0 < P i j → pmin ≤ P i j)
    (irreducible : ∀ (a b : Fin n), Relation.ReflTransGen (fun x y => 0 < P y x) a b) : AnvBandit.ContactMatrix n
def AnvBandit.TimeOrder : ℝ → (ℕ → ℕ → ℝ) → Prop :=
fun β R =>
  ∃ C,
    0 ≤ C ∧
      ∀ (T H : ℕ),
        T ≤ H → R T H ≤ C * (↑H + Real.log (↑T + 1) ^ (β / (β - 1)) / ↑H ^ (β / (β - 1) - 1) + Real.log (↑T + 1) + 1)
def AnvBandit.DecayModel.HKappa : {n K : ℕ} → AnvBandit.DecayModel n K → ℝ → ℕ :=
fun {n K} M L => AnvBandit.kappa n K * M.mMax L
def AnvBandit.expBench : ℕ → {K : ℕ} → 0 < K → (Fin K → ℝ) → (Fin K → ℝ) → (Fin K → ℝ) → ℕ → ℝ :=
fun n {K} hK b a eta t => Finset.univ.sup' ⋯ (AnvBandit.syncExpVal n b a eta)
def AnvBandit.Vstar1 : {n K : ℕ} → {T : ℕ} → AnvBandit.DecayModel n K → ℝ :=
fun {n K T} M => Finset.univ.sup' ⋯ (AnvBandit.J1 M)
