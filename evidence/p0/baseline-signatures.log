theorem AnvBandit.proposition_A_4 : ∀ (n : ℕ) {K : ℕ} (hK : 0 < K) (b a eta : Fin K → ℝ),
  (∀ (k : Fin K), 0 ≤ a k) →
    (∀ (k : Fin K), 0 < eta k) → ∀ (t : ℕ), AnvBandit.expBench n hK b a eta t = AnvBandit.greedyVal n hK b a eta t :=
fun n {K} hK b a eta ha heta t =>
  le_antisymm (AnvBandit.expBench_le_greedyVal n hK b a eta t) (AnvBandit.greedyVal_le_expBench n hK b a eta t ha heta)
theorem AnvBandit.measure_adaptive_abs_le_sampled.{u_1} : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω]
  (μ : MeasureTheory.Measure Ω) [inst_1 : MeasureTheory.IsProbabilityMeasure μ] [inst_2 : StandardBorelSpace Ω]
  (ℱ : MeasureTheory.Filtration ℕ inst) (D X : ℕ → Ω → ℝ) (muc : ℕ → ℝ),
  (∀ (t : ℕ), MeasureTheory.StronglyMeasurable (D t)) →
    (∀ (t : ℕ), MeasureTheory.StronglyMeasurable (X t)) →
      ProbabilityTheory.HasSubgaussianMGF (fun ω => D 0 ω * (X 0 ω - muc 0)) (1 / 8) μ →
        ProbabilityTheory.HasSubgaussianMGF (fun ω => -(D 0 ω * (X 0 ω - muc 0))) (1 / 8) μ →
          (∀ (t : ℕ),
              ProbabilityTheory.HasCondSubgaussianMGF (↑ℱ (t - 1)) ⋯ (fun ω => D t ω * (X t ω - muc t)) (1 / 8) μ) →
            (∀ (t : ℕ),
                ProbabilityTheory.HasCondSubgaussianMGF (↑ℱ (t - 1)) ⋯ (fun ω => -(D t ω * (X t ω - muc t))) (1 / 8)
                  μ) →
              ∀ (m : ℕ) {x : ℝ},
                0 ≤ x →
                  μ.real
                      {ω |
                        ∑ t ∈ Finset.range m, D t ω = ↑m ∧ ↑m * x ≤ |∑ t ∈ Finset.range m, D t ω * (X t ω - muc t)|} ≤
                    2 * Real.exp (-(2 * (↑m * x ^ 2))) :=
fun {Ω} [MeasurableSpace Ω] μ [MeasureTheory.IsProbabilityMeasure μ] [StandardBorelSpace Ω] ℱ D X muc hDm hXm h0 h0n
    hsub hsubn m {x} hx =>
  le_trans
    (MeasureTheory.measureReal_mono (fun ⦃ω⦄ hω => id hω.right)
      (MeasureTheory.measure_ne_top μ {ω | ↑m * x ≤ |∑ t ∈ Finset.range m, D t ω * (X t ω - muc t)|}))
    (AnvBandit.measure_adaptive_abs_le μ ℱ D X muc hDm hXm h0 h0n hsub hsubn m hx)
