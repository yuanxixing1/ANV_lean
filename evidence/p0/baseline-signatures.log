    (b_le_one : ∀ (k : Fin K), b k ≤ 1) (f_nonneg : ∀ (k : Fin K) (s : ℕ), 0 ≤ f k s)
    (f_anti : ∀ (k : Fin K), Antitone (f k)) (f_tendsto : ∀ (k : Fin K), Filter.Tendsto (f k) Filter.atTop (nhds 0))
    (f_le_gap : ∀ (k : Fin K) (s : ℕ), f k s ≤ 1 - b k) (b_le_star : ∀ (k : Fin K), b k ≤ b star)
    (star_unique : ∀ (k : Fin K), b k = b star → k = star) (two_le_n : 2 ≤ n) (two_le_K : 2 ≤ K) :
    AnvBandit.DecayModel n K
structure AnvBandit.GoodRun {n K : ℕ} (M : AnvBandit.DecayModel n K) : Type
number of parameters: 3
fields:
  AnvBandit.GoodRun.L : ℝ
  AnvBandit.GoodRun.hL : 0 ≤ self.L
  AnvBandit.GoodRun.bhat : Fin n → Fin K → ℕ → ℝ
  AnvBandit.GoodRun.p : Fin n → Fin K → ℕ → ℝ
  AnvBandit.GoodRun.hp : ∀ (i : Fin n), M.AdaptMeanInGap (self.p i)
  AnvBandit.GoodRun.hc : ∀ (i : Fin n), AnvBandit.DecayModel.ConcEvent self.L (self.bhat i) (self.p i)
  AnvBandit.GoodRun.I : ℕ → Fin n → Fin K
  AnvBandit.GoodRun.N : ℕ → Fin n → Fin K → ℕ
  AnvBandit.GoodRun.Nzero : ∀ (i : Fin n) (k : Fin K), self.N 0 i k = 0
  AnvBandit.GoodRun.Nstep : ∀ (t : ℕ) (i : Fin n) (k : Fin K),
      self.N (t + 1) i k = self.N t i k + if self.I t i = k then 1 else 0
  AnvBandit.GoodRun.active : ℕ → Fin n → Finset (Fin K)
  AnvBandit.GoodRun.sel_mem : ∀ (t : ℕ) (i : Fin n), self.I t i ∈ self.active t i
  AnvBandit.GoodRun.ucb : ∀ (t : ℕ) (i : Fin n),
      M.star ∈ self.active t i →
        self.N t i (self.I t i) = 0 ∨
          1 ≤ self.N t i (self.I t i) ∧
            1 ≤ self.N t i M.star ∧
              self.bhat i M.star (self.N t i M.star) + AnvBandit.rdelta self.L (self.N t i M.star) ≤
                self.bhat i (self.I t i) (self.N t i (self.I t i)) + AnvBandit.rdelta self.L (self.N t i (self.I t i))
